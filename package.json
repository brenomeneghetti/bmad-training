{
  "name": "url-piece-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src tests evidence/*.mjs vite.config.ts playwright.config.ts",
    "test": "vitest run && node --test evidence/validate.test.mjs evidence/run.test.mjs evidence/release.test.mjs",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.cache/browsers TMPDIR=$PWD/.cache/tmp XDG_CACHE_HOME=$PWD/.cache playwright install chromium",
    "test:e2e": "playwright test",
    "evidence:validate": "node evidence/validate.mjs",
    "evidence:run": "node evidence/run.mjs",
    "evidence:release": "node evidence/validate.mjs --release",
    "evidence:story": "node evidence/validate.mjs --story"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tr46": "6.0.0",
    "unicode-case-folding": "1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "create-vite": "9.2.1",
    "jsdom": "29.0.1",
    "oxlint": "1.81.0",
    "typescript": "6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
