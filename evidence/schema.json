{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "epic", "matrixVersion", "evaluatorVersion", "artifact", "toolVersions", "signOff", "cells"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "epic": { "const": 2 },
    "matrixVersion": { "type": "string", "pattern": "^epic-2-v[0-9]+$" },
    "evaluatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "delivery"],
      "properties": {
        "path": { "const": "dist" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "delivery": { "const": "deployment/static-delivery.json" }
      }
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "required": ["node", "pnpm", "vitest", "playwright"]
    },
    "signOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "recordedAt"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "story", "status", "owner", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^story-(?:1-[1-6]|2-[12])-[a-z0-9-]+$" },
          "story": { "enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "2.1", "2.2"] },
          "status": { "const": "pass" },
          "owner": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
